# <----------------------- SERVER -----------------------> #
SERVER_PORT=8080
SERVER_NODE_ENV=development
SERVER_JWT_SECRET=your-jwt-secret-at-least-32-characters-long
SERVER_JWT_TOKEN_TTL=7d
# AES-256-GCM key for the project-secret vault. 64 hex chars (32 bytes).
# Generate with: openssl rand -hex 32
SERVER_SECRET_ENCRYPTION_KEY=

SERVER_REDIS_URL=redis://localhost:6370
SERVER_WEB_URL=http://localhost:3000
SERVER_RESEND_API_KEY=your-resend-api-key
# Sender identity for all outbound mail. Must use a domain verified in Resend;
# the onboarding@resend.dev sandbox sender can only deliver to the account owner.
SERVER_EMAIL_FROM=matcha <noreply@nocturn.app>
# <----------------------- OTP -----------------------> #
SERVER_OTP_TTL_SECONDS=600
SERVER_OTP_COOLDOWN_SECONDS=60
SERVER_OTP_MAX_ATTEMPTS=5
# <----------------------- DATABASE -----------------------> #
DATABASE_URL=postgresql://your-user:your-password@localhost:5434/your-db?schema=public

# <----------------------- GITHUB -----------------------> #
SERVER_GITHUB_APP_ID=
SERVER_GITHUB_APP_SLUG=matcha
SERVER_GITHUB_APP_CLIENT_ID=
SERVER_GITHUB_APP_CLIENT_SECRET=
# base64 of the downloaded .pem:  base64 -i matcha.private-key.pem | tr -d '\n'
SERVER_GITHUB_APP_PRIVATE_KEY=
# optional; reserved for when webhooks are enabled
SERVER_GITHUB_APP_WEBHOOK_SECRET=

# <----------------------- SANDBOX & AGENTS -----------------------> #
SERVER_E2B_API_KEY=
SERVER_ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
SERVER_BRIEF_MODEL=claude-sonnet-5
SERVER_BRIEF_EFFORT=low
SERVER_SOLVE_MODEL=claude-sonnet-5
SERVER_SOLVE_EFFORT=high
# TTL for the per-session token handed to the sandbox as MATCHA_SANDBOX_TOKEN
SERVER_SANDBOX_JWT_TTL=20m
# TTL for the per-worker token handed to the sandbox as MATCHA_SANDBOX_TOKEN
# during issue-solving runs (apps/vm)
SERVER_WORKER_JWT_TTL=90m
# Publicly reachable base URL of apps/server — the sandbox calls back here to report
# worker status/PR outcome. In local dev this needs a tunnel (e.g. ngrok) since E2B
# sandboxes run remotely and can't reach localhost.
SERVER_PUBLIC_API_URL=http://localhost:8080

# <----------------------- WEB -----------------------> #
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
