# ---------------------------- SHARED  —  consumed by two or more services ----------------------------

# <----------------------- DATABASE -----------------------> #
DATABASE_URL=postgresql://your-user:your-password@localhost:4403/your-db?schema=public
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# <----------------------- GITHUB -----------------------> #
GITHUB_APP_ID=
# base64 of the downloaded .pem:  base64 -i matcha.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_URL=http://localhost:4405
# Product Diff artifact storage (MinIO).
PRODUCT_DIFF_BUCKET=product-diffs
# Publicly reachable base URL of apps/server — the sandbox calls back here to report
# worker status/PR outcome. In local dev this needs a tunnel (e.g. ngrok) since E2B
# sandboxes run remotely and can't reach localhost. Bare origin only, no path — sandbox-mcp
# appends /api/v1/... itself, so a trailing /api/v1 here produces a double path and 404s.
PUBLIC_API_URL=http://localhost:4402
REDIS_URL=redis://localhost:4404
# <----------------------- REVALIDATION -----------------------> #
# Shared by apps/server and apps/web. The server POSTs it to apps/web /api/revalidate
# after a post is created/updated/deleted so a publish appears immediately rather than
# waiting out the 60s ISR window. Unset = no purge, site lags by up to 60s.
REVALIDATE_SECRET=
RUN_LOGS_BUCKET=run-logs
# AES-256-GCM key for the project-secret vault. 64 hex chars (32 bytes).
# Generate with: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=
# TTL for the per-worker token handed to the sandbox as MATCHA_SANDBOX_TOKEN
# during issue-solving runs (apps/vm)
WORKER_JWT_TTL=90m

# ---------------------------- SERVER  —  apps/server only ----------------------------

# Comma-separated allowlist. Checked when issuing an admin OTP AND again on every
# admin request, so removing an address here revokes access immediately rather than
# at token expiry. Empty means nobody can sign in to the admin panel.
SERVER_ADMIN_EMAILS=
# TTL for the admin session token. Separate from SERVER_JWT_TOKEN_TTL — admin tokens
# carry scope:"admin" and a public web token is never accepted on an admin route.
SERVER_ADMIN_JWT_TTL=12h
# <----------------------- ADMIN -----------------------> #
# Origin of apps/admin, added to the server's CORS allowlist alongside SERVER_WEB_URL
SERVER_ADMIN_URL=http://localhost:4401
# Sender identity for all outbound mail. Must use a domain verified in Resend;
# the onboarding@resend.dev sandbox sender can only deliver to the account owner.
SERVER_EMAIL_FROM=matcha <noreply@nocturn.app>
SERVER_GCS_BUCKET=
SERVER_GCS_CLIENT_EMAIL=
# base64-encoded PEM, same handling as GITHUB_APP_PRIVATE_KEY
SERVER_GCS_PRIVATE_KEY=
# <----------------------- GCS -----------------------> #
# Post images. The browser PUTs directly to the bucket with a v4 signed URL, so the
# bucket needs its own CORS rule allowing PUT from SERVER_ADMIN_URL, and objects must
# be publicly readable (allUsers:objectViewer) for apps/web to render them.
# Uploads are disabled until all five are set; the rest of the server runs without them.
SERVER_GCS_PROJECT_ID=
SERVER_GCS_PUBLIC_URL=https://storage.googleapis.com/your-bucket
SERVER_GITHUB_APP_SLUG=matcha
# optional; reserved for when webhooks are enabled
SERVER_GITHUB_APP_WEBHOOK_SECRET=
SERVER_JWT_TOKEN_TTL=7d
SERVER_NODE_ENV=development
SERVER_OTP_COOLDOWN_SECONDS=60
SERVER_OTP_MAX_ATTEMPTS=5
# <----------------------- OTP -----------------------> #
SERVER_OTP_TTL_SECONDS=600
# <----------------------- SERVER -----------------------> #
SERVER_PORT=4402
SERVER_RESEND_API_KEY=your-resend-api-key
# TTL for the per-session token handed to the sandbox as MATCHA_SANDBOX_TOKEN
SERVER_SANDBOX_JWT_TTL=20m
SERVER_WEB_URL=http://localhost:4400

# ---------------------------- VM  —  apps/vm only ----------------------------

VM_BRIEF_EFFORT=low
VM_BRIEF_MODEL=claude-sonnet-5
# Generate once with `claude setup-token`. Never commit or bake it into an E2B image.
VM_CLAUDE_CODE_OAUTH_TOKEN=
# how many workers' sandboxes apps/vm can be driving (cloning/running claude/etc.) at once —
# each dispatch job now owns a whole sandbox run, not a quick db update, so this must be > 1
# for multiple sandboxes to actually run in parallel
VM_DISPATCH_CONCURRENCY=10
# <----------------------- SANDBOX & AGENTS -----------------------> #
VM_E2B_API_KEY=
# The vm worker's own listener. Sandboxes post their reported actions here, so this URL must be
# reachable from inside a sandbox; it is never reachable by an end user.
VM_HTTP_PORT=4100
VM_OPENAI_API_KEY=
VM_OPENROUTER_API_KEY=
VM_PREVIEW_EFFORT=high
# Model and effort for the agent that writes the preview harness. Separate from the solve agent
# because it is a much smaller job.
VM_PREVIEW_MODEL=claude-sonnet-5
# How many Product Diff previews may run at once. Each one holds a sandbox for up to 45 minutes
# while it installs the project, boots both revisions and photographs them.
VM_PRODUCT_DIFF_CONCURRENCY=2
VM_PUBLIC_URL=http://localhost:4100
# Sandbox template every runner boots from. Folded into the Product Diff dependency-cache key,
# so renaming it here retires every project's cached node_modules snapshot.
VM_SANDBOX_TEMPLATE=node-py-claude-template:stable
VM_SOLVE_EFFORT=high
VM_SOLVE_MODEL=claude-sonnet-5

# ---------------------------- ROUTER  —  apps/router only ----------------------------

ROUTER_ANTHROPIC_API_KEY=

# ---------------------------- WEB  —  apps/web only ----------------------------

# <----------------------- WEB -----------------------> #
NEXT_PUBLIC_BACKEND_URL=http://localhost:4402

# ---------------------------- UNUSED  —  no code reference found; safe to delete once confirmed ----------------------------

# <----------------------- ADMIN APP -----------------------> #
VITE_BACKEND_URL=http://localhost:4402

# <----------------------- CONNECTORS -----------------------> #
# Per-user chat connectors that carry agent questions out and answers back.
# Each provider is optional; an unconfigured one is simply skipped at delivery.
# api.slack.com/apps → distributed app. Bot scopes: chat:write, im:write, users:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Signs inbound events/interactions. Verified over the raw body, not parsed JSON.
SLACK_SIGNING_SECRET=
# @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# without the @ — used to build the t.me deep link that links an account
TELEGRAM_BOT_USERNAME=
# you generate: openssl rand -hex 32. Passed to setWebhook as secret_token and
# echoed back in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# How long an unanswered agent question holds its sandbox before it is cancelled.
SERVER_AGENT_QUESTION_TTL_SECONDS=86400
# Lifetime of the one-time nonce backing a connector link handshake.
SERVER_CONNECTOR_LINK_TTL_SECONDS=600
