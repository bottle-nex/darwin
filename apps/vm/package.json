{
    "name": "@trymatcha/vm",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "index.ts",
    "scripts": {
        "dev": "bun run --watch index.ts",
        "start": "bun run index.ts",
        "solve": "bun run src/scripts/script.solve_hardcoded_issue.ts",
        "template": "bun run src/scripts/script.build_sandbox_template.ts",
        "template:verify": "bun run src/scripts/script.verify_sandbox_template.ts",
        "test": "bun test src",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@octokit/auth-app": "^8.2.0",
        "@trymatcha/database": "*",
        "@trymatcha/harness": "*",
        "@trymatcha/logger": "*",
        "@trymatcha/types": "*",
        "bullmq": "^5.81.2",
        "chalk": "^5.6.2",
        "dotenv": "^17.4.2",
        "e2b": "^2.36.0",
        "jsonwebtoken": "^9.0.3",
        "minio": "^8.0.7",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@trymatcha/eslint-config": "*",
        "@trymatcha/typescript-config": "*",
        "@types/bun": "latest",
        "@types/jsonwebtoken": "^9.0.10",
        "@typescript-eslint/eslint-plugin": "^7.1.0",
        "@typescript-eslint/parser": "^7.1.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-config-turbo": "^2.0.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-only-warn": "^1.1.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-turbo": "^2.0.0",
        "typescript": "5.5.4"
    }
}
