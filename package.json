{
    "name": "trymatcha",
    "private": true,
    "packageManager": "bun@1.3.2",
    "engines": {
        "node": ">=18"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "prisma": {
        "schema": "packages/database/prisma/schema.prisma",
        "seed": "tsx packages/database/src/seed.ts"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\"",
        "generate": "turbo run generate",
        "db:migrate:deploy": "turbo run db:migrate:deploy",
        "db:migrate:dev": "turbo run db:migrate:dev",
        "db:push": "turbo run db:push",
        "db:seed": "turbo run db:seed",
        "pre-push": "bun run lint && bun run format:check && bun run typecheck",
        "prepare": "husky"
    },
    "dependencies": {
        "@prisma/adapter-pg": "7.8.0",
        "@prisma/client": "7.8.0",
        "lucide-react": "^1.17.0"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "prettier": "^3.2.5",
        "prisma": "7.8.0",
        "tsx": "4.21.0",
        "turbo": "^2.9.16"
    }
}
