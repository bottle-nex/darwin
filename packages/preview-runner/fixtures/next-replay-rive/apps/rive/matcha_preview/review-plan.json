{
    "applications": [
        {
            "id": "rive",
            "applicationPath": "apps/rive",
            "adapterId": "next"
        }
    ],
    "surfaces": [
        {
            "id": "rive-component",
            "applicationId": "rive",
            "label": "Local Rive component",
            "sourcePaths": ["matcha_preview/targets/rive-card.tsx"],
            "entry": {
                "kind": "component",
                "targetId": "rive-card"
            },
            "rootLayoutMode": "inherit",
            "states": [
                {
                    "id": "default",
                    "label": "Default",
                    "scenarios": [
                        {
                            "id": "activate",
                            "label": "Activate local Rive",
                            "actions": [
                                {
                                    "kind": "waitFor",
                                    "selector": {
                                        "testId": "rive-runtime-ready"
                                    }
                                },
                                {
                                    "kind": "click",
                                    "selector": {
                                        "role": "button",
                                        "name": "Activate Rive"
                                    }
                                },
                                {
                                    "kind": "waitFor",
                                    "selector": {
                                        "testId": "rive-changed"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ],
            "viewports": [
                {
                    "id": "desktop",
                    "label": "Desktop",
                    "width": 1280,
                    "height": 800
                }
            ]
        }
    ]
}
