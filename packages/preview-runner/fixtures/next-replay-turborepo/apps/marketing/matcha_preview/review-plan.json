{
    "applications": [
        {
            "id": "marketing",
            "applicationPath": "apps/marketing",
            "adapterId": "next"
        }
    ],
    "surfaces": [
        {
            "id": "shared-route",
            "applicationId": "marketing",
            "label": "Shared package route",
            "sourcePaths": ["app/replay/page.tsx"],
            "entry": {
                "kind": "route",
                "path": "/replay"
            },
            "rootLayoutMode": "inherit",
            "states": [
                {
                    "id": "default",
                    "label": "Default",
                    "scenarios": [
                        {
                            "id": "activate",
                            "label": "Activate shared UI",
                            "actions": [
                                {
                                    "kind": "click",
                                    "selector": {
                                        "role": "button",
                                        "name": "Activate shared UI"
                                    }
                                },
                                {
                                    "kind": "waitFor",
                                    "selector": {
                                        "testId": "turbo-changed"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ],
            "viewports": [
                {
                    "id": "desktop",
                    "label": "Desktop",
                    "width": 1280,
                    "height": 800
                }
            ]
        }
    ]
}
