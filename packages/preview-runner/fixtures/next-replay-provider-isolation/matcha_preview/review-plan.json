{
    "applications": [
        {
            "id": "providers",
            "applicationPath": ".",
            "adapterId": "next"
        }
    ],
    "surfaces": [
        {
            "id": "provider-inherited",
            "applicationId": "providers",
            "label": "Inherited provider",
            "sourcePaths": ["app/providers.tsx"],
            "entry": {
                "kind": "component",
                "targetId": "provider-card"
            },
            "rootLayoutMode": "inherit",
            "states": [
                {
                    "id": "default",
                    "label": "Default",
                    "scenarios": [
                        {
                            "id": "activate",
                            "label": "Activate inherited provider",
                            "actions": [
                                {
                                    "kind": "waitFor",
                                    "selector": {
                                        "testId": "inherited-layout"
                                    }
                                },
                                {
                                    "kind": "click",
                                    "selector": {
                                        "role": "button",
                                        "name": "Activate inherited"
                                    }
                                },
                                {
                                    "kind": "waitFor",
                                    "selector": {
                                        "testId": "inherited-changed"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ],
            "viewports": [
                {
                    "id": "desktop",
                    "label": "Desktop",
                    "width": 1280,
                    "height": 800
                }
            ]
        },
        {
            "id": "provider-isolated",
            "applicationId": "providers",
            "label": "Isolated provider",
            "sourcePaths": ["app/providers.tsx"],
            "entry": {
                "kind": "component",
                "targetId": "provider-card"
            },
            "rootLayoutMode": "isolate",
            "states": [
                {
                    "id": "default",
                    "label": "Default",
                    "scenarios": [
                        {
                            "id": "activate",
                            "label": "Activate isolated provider",
                            "actions": [
                                {
                                    "kind": "waitFor",
                                    "selector": {
                                        "testId": "isolated-layout"
                                    }
                                },
                                {
                                    "kind": "click",
                                    "selector": {
                                        "role": "button",
                                        "name": "Activate isolated"
                                    }
                                },
                                {
                                    "kind": "waitFor",
                                    "selector": {
                                        "testId": "isolated-changed"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ],
            "viewports": [
                {
                    "id": "desktop",
                    "label": "Desktop",
                    "width": 1280,
                    "height": 800
                }
            ]
        }
    ]
}
