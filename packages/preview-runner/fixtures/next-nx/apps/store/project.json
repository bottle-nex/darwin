{
    "name": "@matcha-fixture/store",
    "projectType": "application",
    "sourceRoot": "apps/store",
    "targets": {
        "build": {
            "executor": "@nx/next:build",
            "options": {
                "outputPath": "dist/apps/store"
            }
        },
        "serve": {
            "executor": "@nx/next:server",
            "options": {
                "buildTarget": "@matcha-fixture/store:build",
                "dev": true
            }
        }
    }
}
