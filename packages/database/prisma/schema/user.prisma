enum SidebarTheme {
  TimeOfDay
  Lilac
  Slate
  Neutral
}

enum BackgroundLightingColor {
  Violet
  Matcha
  Blue
  Amber
  Rose
  Neutral
}

// Syntax colours for the code diff in a review's Changes tab. Darwin is the house
// theme; the actual colour values live in apps/web/lib/codeThemes.ts.
enum CodeTheme {
  Darwin
  NightOwl
  OneDark
  Dracula
  Nord
  MaterialOceanic
  GruvboxDark
  VscDarkPlus
  A11yDark
}

/// Which sidebar face a two-finger swipe opens. `Off` disables the gesture, which matters on
/// trackpads where an ordinary horizontal scroll is easy to trigger by accident.
enum SwipeTarget {
  Settings
  Darwin
  Off
}

enum DiffView {
  Unified
  Split
}

enum ColorScheme {
  Dark
  Light
  System
}

enum DefaultHomeView {
  AskDarwin
  Inbox
  Chats
  Kanban
  Spaces
  Gantt
  Tags
  AssignedToMe
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  emailVerified DateTime?
  setupComplete Boolean   @default(false)

  sidebarTheme SidebarTheme @default(TimeOfDay)

  lastVisitedOrgId     String?
  lastVisitedProjectId String?
  lastVisitedOrg       Organization? @relation("UserLastVisitedOrg", fields: [lastVisitedOrgId], references: [id], onDelete: SetNull)
  lastVisitedProject   Project?      @relation("UserLastVisitedProject", fields: [lastVisitedProjectId], references: [id], onDelete: SetNull)

  orgMemberships       OrgMember[]
  teamMemberships      TeamMember[]
  projectMemberships   ProjectMember[]
  ownedProjects        Project[]            @relation("ProjectOwner")
  createdProjects      Project[]            @relation("ProjectCreator")
  createdOrganizations Organization[]       @relation("OrgCreator")
  invitations          Invitation[]         @relation("InviteRecipient")
  sentInvitations      Invitation[]         @relation("InviteSender")
  githubAccount        GithubAccount?
  githubInstallations  GithubInstallation[] @relation("GithubInstallationConnector")

  createdIssues  Issue[] @relation(name: "IssueCreator")
  assignedIssues Issue[] @relation(name: "IssueAssignees")
  createdTags    Tag[]   @relation(name: "TagCreator")

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  chats                Chat[]
  projectChats         ProjectChat[]
  teamChats            TeamChat[]
  chatReactions        ChatReaction[]
  projectChatReactions ProjectChatReaction[]
  teamChatReactions    TeamChatReaction[]

  customColumnOrders   CustomColumnOrder[]
  issueViewPreferences IssueViewPreference[]
  notifications        Notification[]
  issueActivities      IssueActivity[]       @relation(name: "ActivityActor")
  apiKeys              ApiKey[]
  config               UserConfig?
  githubImportConfigs  GithubIssueImport[]   @relation(name: "GithubImportConfigurer")
  connectors           Connector[]
  connectorLinkTokens  ConnectorLinkToken[]
  darwinThreads        DarwinThread[]
}

model UserConfig {
  id                        String                  @id @default(cuid())
  userId                    String                  @unique
  user                      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  backgroundLightingEnabled Boolean                 @default(false)
  backgroundLightingColor   BackgroundLightingColor @default(Violet)
  defaultHomeView           DefaultHomeView         @default(Kanban)
  codeTheme                 CodeTheme               @default(Darwin)
  diffView                  DiffView                @default(Unified)
  swipeTarget               SwipeTarget             @default(Settings)
  colorScheme               ColorScheme             @default(Dark)
}

model GithubAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  githubUserId BigInt    @unique
  githubLogin  String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
