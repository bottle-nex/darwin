model SetupSession {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status           SetupStatus @default(Pending)
  sandboxId        String? // live E2B sandbox id
  snapshotId       String? // warm snapshot id, set once baseline is green
  infrastructureMd String?     @db.Text // generated infrastructure.md

  error      String?
  startedAt  DateTime?
  finishedAt DateTime?

  questions AgentQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model AgentQuestion {
  id             String        @id @default(cuid())
  setupSessionId String?
  setupSession   SetupSession? @relation(fields: [setupSessionId], references: [id], onDelete: Cascade)
  agentSessionId String?
  agentSession   AgentSession? @relation(fields: [agentSessionId], references: [id], onDelete: Cascade)

  type    AgentQuestionType
  key     String // "NPM_TOKEN", "START_COMMAND", ...
  prompt  String              @db.Text
  options String[] // for NeedChoice / Confirm
  status  AgentQuestionStatus @default(Waiting)

  // answer handling — NEVER store a secret value here
  answerValue String?        @db.Text // non-secret answers
  secretId    String? // pointer to the vault row for secret answers
  secret      ProjectSecret? @relation(fields: [secretId], references: [id], onDelete: SetNull)

  deliveries QuestionDelivery[]

  timeoutBehavior TimeoutBehavior @default(Proceed)

  askedAt    DateTime  @default(now())
  expiresAt  DateTime?
  answeredAt DateTime?

  @@index([setupSessionId, status])
  @@index([agentSessionId, status])
}

model ProjectSecret {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  key        String // "DATABASE_URL", "NPM_TOKEN"
  ciphertext String @db.Text // AES-256-GCM encrypted value
  iv         String // GCM nonce
  authTag    String // GCM auth tag

  questions AgentQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
}

enum SetupStatus {
  Pending
  Provisioning
  Cloning
  Detecting
  InstallingDeps
  BootingServices
  WaitingOnUser
  Verifying
  Ready
  Failed
}

enum TimeoutBehavior {
  Proceed
  Deny
}

enum AgentQuestionType {
  NeedSecret
  NeedValue
  NeedChoice
  Confirm
  NeedFile
  NeedAccess
  DefineSuccess
  Clarify
  ApproveCost
  ApprovePullRequest
}

enum AgentQuestionStatus {
  Waiting
  Answered
  Cancelled
}
