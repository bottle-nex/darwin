model Chat {
  id          String  @id @default(cuid())
  issueId     String
  senderId    String?
  message     String  @db.Text
  isDeleted   Boolean @default(false)
  repliedToId String?

  issue      Issue              @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sender     User?              @relation(fields: [senderId], references: [id], onDelete: SetNull)
  repliedTo  Chat?              @relation("ChatReplies", fields: [repliedToId], references: [id], onDelete: SetNull)
  replies    Chat[]             @relation("ChatReplies")
  references MessageReference[]
  reactions  ChatReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
  @@index([issueId, createdAt, id])
}

model ChatReaction {
  id     String @id @default(cuid())
  chatId String
  userId String
  emoji  String @db.VarChar(32)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
}

model ProjectChat {
  id          String  @id @default(cuid())
  projectId   String
  senderId    String?
  message     String  @db.Text
  isDeleted   Boolean @default(false)
  repliedToId String?

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender     User?                 @relation(fields: [senderId], references: [id], onDelete: SetNull)
  repliedTo  ProjectChat?          @relation("ProjectChatReplies", fields: [repliedToId], references: [id], onDelete: SetNull)
  replies    ProjectChat[]         @relation("ProjectChatReplies")
  references MessageReference[]
  reactions  ProjectChatReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, createdAt, id])
}

model ProjectChatReaction {
  id            String @id @default(cuid())
  projectChatId String
  userId        String
  emoji         String @db.VarChar(32)

  projectChat ProjectChat @relation(fields: [projectChatId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectChatId, userId])
  @@index([projectChatId])
  @@index([userId])
}

model TeamChat {
  id          String  @id @default(cuid())
  teamId      String
  senderId    String?
  message     String  @db.Text
  isDeleted   Boolean @default(false)
  repliedToId String?

  team       Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender     User?              @relation(fields: [senderId], references: [id], onDelete: SetNull)
  repliedTo  TeamChat?          @relation("TeamChatReplies", fields: [repliedToId], references: [id], onDelete: SetNull)
  replies    TeamChat[]         @relation("TeamChatReplies")
  references MessageReference[]
  reactions  TeamChatReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([teamId, createdAt, id])
}

model TeamChatReaction {
  id         String @id @default(cuid())
  teamChatId String
  userId     String
  emoji      String @db.VarChar(32)

  teamChat TeamChat @relation(fields: [teamChatId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teamChatId, userId])
  @@index([teamChatId])
  @@index([userId])
}

/// An entity tagged inside a message body. The body stores an opaque
/// `@[member:<id>]` / `#[issue:<id>]` token, so this row carries no offset —
/// it exists to make the reverse lookup ("where is this issue discussed?")
/// indexable and to drive notification fan-out. Exactly one source column and
/// exactly one target column are set, enforced by CHECK constraints that
/// Prisma cannot express.
model MessageReference {
  id            String  @id @default(cuid())
  chatId        String?
  projectChatId String?
  teamChatId    String?
  memberId      String?
  issueId       String?

  chat        Chat?          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  projectChat ProjectChat?   @relation(fields: [projectChatId], references: [id], onDelete: Cascade)
  teamChat    TeamChat?      @relation(fields: [teamChatId], references: [id], onDelete: Cascade)
  member      ProjectMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  issue       Issue?         @relation(fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([projectChatId])
  @@index([teamChatId])
  @@index([memberId])
  @@index([issueId])
}
