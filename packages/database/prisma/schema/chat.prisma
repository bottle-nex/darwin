model Chat {
  id          String  @id @default(cuid())
  issueId     String
  senderId    String?
  message     String  @db.Text
  isDeleted   Boolean @default(false)
  repliedToId String?

  issue      Issue              @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sender     User?              @relation(fields: [senderId], references: [id], onDelete: SetNull)
  repliedTo  Chat?              @relation("ChatReplies", fields: [repliedToId], references: [id], onDelete: SetNull)
  replies    Chat[]             @relation("ChatReplies")
  references MessageReference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
}

model ProjectChat {
  id          String  @id @default(cuid())
  projectId   String
  senderId    String?
  message     String  @db.Text
  isDeleted   Boolean @default(false)
  repliedToId String?

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender     User?              @relation(fields: [senderId], references: [id], onDelete: SetNull)
  repliedTo  ProjectChat?       @relation("ProjectChatReplies", fields: [repliedToId], references: [id], onDelete: SetNull)
  replies    ProjectChat[]      @relation("ProjectChatReplies")
  references MessageReference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// An entity tagged inside a message body. The body stores an opaque
/// `@[member:<id>]` / `#[issue:<id>]` token, so this row carries no offset —
/// it exists to make the reverse lookup ("where is this issue discussed?")
/// indexable and to drive notification fan-out. Exactly one source column and
/// exactly one target column are set, enforced by CHECK constraints that
/// Prisma cannot express.
model MessageReference {
  id            String  @id @default(cuid())
  chatId        String?
  projectChatId String?
  memberId      String?
  issueId       String?

  chat        Chat?          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  projectChat ProjectChat?   @relation(fields: [projectChatId], references: [id], onDelete: Cascade)
  member      ProjectMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  issue       Issue?         @relation(fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([projectChatId])
  @@index([memberId])
  @@index([issueId])
}
