model Notification {
  id        String           @id @default(cuid())
  userId    String
  projectId String?
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, projectId, createdAt, id])
  @@index([userId, projectId, readAt])
}

enum NotificationType {
  IssueAssigned
  IssueUnassigned
  ChatMention
  ProjectChatMention
  TeamChatMention
  IssueStatusChanged
  IssuePriorityChanged
  IssueMoved
  IssueCommented
  IssueReferenced
  IssueDeleted
  InviteAccepted
  AddedToProject
  AddedToTeam
  RemovedFromTeam
  RemovedFromOrg
  RoleChanged
  MessageReacted
}
