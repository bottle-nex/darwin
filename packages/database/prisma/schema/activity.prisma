model IssueActivity {
  id String @id @default(cuid())

  // this stores the sequence number for each activity row (basically what happened first)
  seq     BigInt @default(autoincrement())
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  type ActivityType

  // this is the most crucial point, as it stores the JSON (instead of strict DS)
  payload Json?

  actorType     ActorType
  actorUserId   String?
  actorUser     User?     @relation(name: "ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorWorkerId String?
  actorWorker   Worker?   @relation(name: "ActivityWorker", fields: [actorWorkerId], references: [id], onDelete: SetNull)

  surface ActivitySurface @default(Primary)

  // this is created when an agent session starts to work on an issue
  sessionId String?
  session   AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // this is used to drop duplicate activity rows
  dedupeKey String?

  createdAt DateTime @default(now())

  @@unique([issueId, dedupeKey])
  @@index([issueId, seq])
  @@index([sessionId])
}

// an agent session is created when an agent starts working on an issue
model AgentSession {
  id       String  @id
  issueId  String
  issue    Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  workerId String?
  worker   Worker? @relation(fields: [workerId], references: [id], onDelete: SetNull)

  attemptNumber Int                @default(1)
  status        AgentSessionStatus @default(Running)

  /// What actually ran, stamped at spawn — not just what was requested. harnessVersion comes
  /// from `binary --version` inside the sandbox, and templateBuild is the E2B build id rather
  /// than the mutable `:stable` tag, since that's what makes a bad run reproducible later.
  harness        Harness?
  harnessVersion String?
  model          String?
  effort         Effort?

  // a basic summary of what changed
  summary  String?
  /// This run's section of the issue's solve report — the agent's own account of what was
  /// wrong, what it changed, and what it ruled out. One per run and never rewritten, so a
  /// reopened issue keeps every earlier attempt's reasoning; the pane joins them in order.
  report   String? @db.Text
  /// { numTurns, durationMs, commits?, filesChanged? }
  stats    Json?
  /// { totalCostUsd, sandboxSeconds? }
  cost     Json?
  /// Full tool-call trace. Mirrors Worker.contextBlobUrl, scoped to one attempt.
  traceUrl String?
  error    String?

  logsKey          String?
  logsLineCount    Int     @default(0)
  logsDroppedLines Int     @default(0)
  logsSizeBytes    Int     @default(0)

  activities IssueActivity[]

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([issueId, startedAt])
  @@index([workerId, status])
}

enum AgentSessionStatus {
  Running
  Succeeded
  Failed
  Aborted
}

enum ActorType {
  User
  Agent
  System
  Github
}

enum ActivitySurface {
  Primary // renders in the feed
  Secondary // hides behind "show details"
  Audit // never renders
}

enum ActivityType {
  // lifecycle
  IssueCreated
  IssueReopened
  IssueResolved
  IssueCancelled
  IssueArchived
  IssueDeleted

  // field edits
  StatusChanged
  PriorityChanged
  TitleChanged
  DescriptionChanged
  AssigneeAdded
  AssigneeRemoved
  LabelAdded
  LabelRemoved
  DatesChanged
  ColumnChanged
  SpecializationChanged
  HarnessConfigChanged

  // relationships
  RelationAdded
  RelationRemoved
  SplitIntoSubIssues

  // queue and routing
  Queued
  Routed
  Reprioritized
  Preempted
  Starved

  // agent run
  RunStarted
  RunCompleted
  AttemptFailed
  RunAborted
  WorkerHandoff
  WorkerDied
  HumanTookOver
  HandedBackToHuman

  // verification
  BugReproduced
  BugNotReproduced
  BuildResult
  TestResult
  AcceptanceChecked

  // github
  BranchCreated
  CommitsPushed
  PrOpened
  PrReviewReceived
  PrFeedbackAddressed
  PrChecksFailed
  PrRebased
  PrMerged
  PrClosed
  PrReverted

  // outbound MCP
  ExternalMessageSent
  ExternalIssueOpened
  ExternalDocUpdated
  OncallPaged

  // security and cost
  ScopeRequested
  ScopeGranted
  ScopeDenied
  GuardrailHit
  SecretAccessed
  BudgetThresholdCrossed
  BudgetExceeded

  // comms
  AttachmentAdded
}
