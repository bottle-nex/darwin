datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  emailVerified DateTime?
  setupComplete Boolean   @default(false)

  orgMemberships       OrgMember[]
  teamMemberships      TeamMember[]
  projectMemberships   ProjectMember[]
  ownedProjects        Project[]            @relation("ProjectOwner")
  createdProjects      Project[]            @relation("ProjectCreator")
  createdOrganizations Organization[]       @relation("OrgCreator")
  invitations          Invitation[]         @relation("InviteRecipient")
  sentInvitations      Invitation[]         @relation("InviteSender")
  githubAccount        GithubAccount?
  githubInstallations  GithubInstallation[] @relation("GithubInstallationConnector")

  createdIssues  Issue[] @relation(name: "IssueCreator")
  assignedIssues Issue[] @relation(name: "IssueAssignees")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chats        Chat[]
  projectChats ProjectChat[]

  customColumnOrders CustomColumnOrder[]
  notifications      Notification[]
}

model Organization {
  id          String  @id @default(cuid())
  createdById String
  name        String
  slug        String  @unique
  description String?

  members            OrgMember[]
  projects           Project[]
  invitations        Invitation[]
  createdBy          User                @relation("OrgCreator", fields: [createdById], references: [id])
  githubInstallation GithubInstallation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrgMember {
  id     String  @id @default(cuid())
  orgId  String
  userId String
  role   OrgRole

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, userId])
  @@index([userId])
}

model Project {
  id            String  @id @default(cuid())
  orgId         String
  name          String
  slug          String
  summary       String?
  description   String?
  ownerId       String
  createdById   String?
  color         String?
  tourCompleted Boolean @default(false)

  githubRepoId        BigInt?
  githubRepoFullName  String?
  githubRepoUrl       String?
  githubDefaultBranch String?

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy    User?           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  teams        Team[]
  members      ProjectMember[]
  invitations  Invitation[]

  githubInstallationId String?
  githubInstallation   GithubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  codeEmbeddings       CodeEmbedding[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  routingClaimedAt   DateTime?
  issues             Issue[]
  projectChats       ProjectChat[]
  customColumns      CustomColumn[]
  customColumnOrders CustomColumnOrder[]
  setupSessions      SetupSession[]
  secrets            ProjectSecret[]
  tags               Tag[]
  issueTemplates     IssueTemplate[]
  planMd             String?             @db.Text
  planStatus         PlanStatus          @default(Pending)
  planCommitSha      String?
  planGeneratedAt    DateTime?

  workers       Worker[]
  maxWorkers    Int            @default(1)

  projectConfig ProjectConfig?

  @@unique([orgId, slug])
  @@index([ownerId])
  @@index([githubInstallationId])
}

model ProjectConfig {
  id               String           @id @default(cuid())
  projectId        String           @unique
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kanbanOptionView KanbanOptionView @default(FLAT)
}

enum KanbanOptionView {
  FLAT
  GROUPED
}

model Tag {
  id    String @id @default(cuid())
  name  String
  color String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
}

/// A pre-written issue body. Same rich-text HTML an issue description is stored in, because
/// a template is exactly that — an issue somebody already wrote, saved and reused.
model IssueTemplate {
  id          String  @id @default(cuid())
  name        String
  summary     String?
  description String  @db.Text
  /// An `IconPick`: a named icon with a colour, or an emoji. Null falls back to a document glyph.
  icon        Json?
  isDefault   Boolean @default(false)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model Team {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  slug        String
  description String?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  chatMentions        ChatMention[]
  projectChatMentions ProjectChatMention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

model TeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  role   TeamRole

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
}

model Invitation {
  id        String           @id @default(cuid())
  email     String
  // Null until the invited email has a matching account: invites are bound to an
  // email so they can be sent before the recipient signs up, and userId is stamped
  // when the invite is accepted (or when the account already exists at send time).
  token     String           @unique @default(cuid())
  status    InvitationStatus @default(Pending)
  expiresAt DateTime

  userId String?
  user   User?   @relation("InviteRecipient", fields: [userId], references: [id], onDelete: SetNull)

  invitedById String
  invitedBy   User   @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      ProjectRole?

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, orgId, teamId])
  @@index([email, status])
}

model GithubInstallation {
  id             String @id @default(cuid())
  orgId          String @unique
  installationId BigInt @unique
  accountLogin   String
  accountType    String
  accountId      BigInt
  connectedById  String

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connectedBy  User         @relation("GithubInstallationConnector", fields: [connectedById], references: [id], onDelete: Restrict)
  projects     Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([connectedById])
}

model GithubAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  githubUserId BigInt    @unique
  githubLogin  String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Issue {
  id          String      @id @default(cuid())
  projectId   String
  number      Int
  createdById String
  title       String
  summary     String?
  description String      @db.Text
  status      IssueStatus @default(Todo)
  priority    Int         @default(3) // 1=Urgent 2=High 3=Normal 4=Low
  startDate   DateTime?
  targetDate  DateTime?

  customColumnId String? // non-null = parked in a user column

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator      User          @relation(name: "IssueCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignees    User[]        @relation(name: "IssueAssignees")
  tags         Tag[]
  customColumn CustomColumn? @relation(fields: [customColumnId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  chats      Chat[]

  assignerWorkerId String?
  assignedWorker   Worker? @relation(fields: [assignerWorkerId], references: [id], onDelete: Cascade)

  queuePosition  Int?
  specialization String?

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, customColumnId])
  @@index([status, createdAt])
  @@index([assignerWorkerId, status, queuePosition])
}

model Chat {
  id          String  @id @default(cuid())
  issueId     String
  senderId    String?
  message     String  @db.Text
  isDeleted   Boolean @default(false)
  repliedToId String?

  issue     Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sender    User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  repliedTo Chat?         @relation("ChatReplies", fields: [repliedToId], references: [id], onDelete: SetNull)
  replies   Chat[]        @relation("ChatReplies")
  mentions  ChatMention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
}

/// A user @-tagged in a Chat message. References the ProjectMember (not User
/// directly) so a mention is always scoped to someone who actually has access
/// to the project the chat belongs to.
model ChatMention {
  id       String @id @default(cuid())
  chatId   String
  memberId String

  chat   Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  member ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([chatId, memberId])
  @@index([memberId])
}

model ProjectChat {
  id          String  @id @default(cuid())
  projectId   String
  senderId    String?
  message     String  @db.Text
  isDeleted   Boolean @default(false)
  repliedToId String?

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User?                @relation(fields: [senderId], references: [id], onDelete: SetNull)
  repliedTo ProjectChat?         @relation("ProjectChatReplies", fields: [repliedToId], references: [id], onDelete: SetNull)
  replies   ProjectChat[]        @relation("ProjectChatReplies")
  mentions  ProjectChatMention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// A user @-tagged in a ProjectChat message. References the ProjectMember (not
/// User directly) so a mention is always scoped to someone who actually has
/// access to the project the chat belongs to.
model ProjectChatMention {
  id            String @id @default(cuid())
  projectChatId String
  memberId      String

  projectChat ProjectChat   @relation(fields: [projectChatId], references: [id], onDelete: Cascade)
  member      ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectChatId, memberId])
  @@index([memberId])
}

model CustomColumn {
  id        String @id @default(cuid())
  projectId String
  label     String
  order     Int

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues     Issue[]
  userOrders CustomColumnOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// A user's personal position for a custom column within a project. Only
/// pinned (reordered) columns get a row here — columns without one fall back
/// to `CustomColumn.order`, sorted after every pinned column for that user.
model CustomColumnOrder {
  id        String @id @default(cuid())
  userId    String
  projectId String
  columnId  String
  order     Int

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column  CustomColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, columnId])
  @@index([userId, projectId])
}

model CodeEmbedding {
  id        String                      @id
  projectId String
  filePath  String
  chunkText String
  chunkType Chunk
  startLine Int
  endLinTe  Int
  embedding Unsupported("vector(1536)")
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("code_embeddings")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model SetupSession {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status           SetupStatus @default(Pending)
  sandboxId        String? // live E2B sandbox id
  snapshotId       String? // warm snapshot id, set once baseline is green
  infrastructureMd String?     @db.Text // generated infrastructure.md

  error      String?
  startedAt  DateTime?
  finishedAt DateTime?

  questions SetupQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model SetupQuestion {
  id        String       @id @default(cuid())
  sessionId String
  session   SetupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type    SetupQuestionType
  key     String // "NPM_TOKEN", "START_COMMAND", ...
  prompt  String              @db.Text
  options String[] // for NeedChoice / Confirm
  status  SetupQuestionStatus @default(Waiting)

  // answer handling — NEVER store a secret value here
  answerValue String?        @db.Text // non-secret answers
  secretId    String? // pointer to the vault row for secret answers
  secret      ProjectSecret? @relation(fields: [secretId], references: [id], onDelete: SetNull)

  askedAt    DateTime  @default(now())
  answeredAt DateTime?

  @@index([sessionId, status])
}

model ProjectSecret {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  key        String // "DATABASE_URL", "NPM_TOKEN"
  ciphertext String @db.Text // AES-256-GCM encrypted value
  iv         String // GCM nonce
  authTag    String // GCM auth tag

  questions SetupQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
}

// the actual VM
model Worker {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  specialization String?
  status         WorkerStatus

  sandboxId      String?
  contextSummary Json? // this will contain queuedCount, currentSpecialization, recentFilesEdited, lastIssue fixed, etc... -> basically for routing decisions
  contextBlobUrl String? // this willl contain transcripts, logs, etc. vm-worker will read it before dispatching the project's issues to a worker, so it can rehydrate the worker/ VM, or else every issue will start fresh, no previous state known

  nextQueuePos   Int       @default(1)
  leaseExpiresAt DateTime?

  issues Issue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([projectId, specialization])
}

enum PlanStatus {
  Pending
  Generating
  Ready
  Failed
}

enum WorkerStatus {
  Booting
  Idle
  Busy
  Dead
}

enum SetupStatus {
  Pending
  Provisioning
  Cloning
  Detecting
  InstallingDeps
  BootingServices
  WaitingOnUser
  Verifying
  Ready
  Failed
}

enum SetupQuestionType {
  NeedSecret
  NeedValue
  NeedChoice
  Confirm
  NeedFile
  NeedAccess
  DefineSuccess
  Clarify
  ApproveCost
}

enum SetupQuestionStatus {
  Waiting
  Answered
  Cancelled
}

enum Chunk {
  Imports
  Function
  Class
  Interface
  Type
  Variable
  Block
}

enum InvitationStatus {
  Pending
  Accepted
  Rejected
}

enum OrgRole {
  Owner
  Admin
  Member
  Billing
}

enum IssueStatus {
  Todo
  Queued
  InProgress
  InReview
  Done
  Failed
  Cancelled
  Parked
}

enum ProjectRole {
  Admin
  Maintain
  Write
  Triage
  Read
}

enum NotificationType {
  IssueAssigned
  IssueUnassigned
  ChatMention
  ProjectChatMention
}

enum TeamRole {
  Maintainer
  Member
}
