datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  emailVerified DateTime?
  setupComplete Boolean   @default(false)

  orgMemberships       OrgMember[]
  teamMemberships      TeamMember[]
  ownedProjects        Project[]            @relation("ProjectOwner")
  createdProjects      Project[]            @relation("ProjectCreator")
  createdOrganizations Organization[]       @relation("OrgCreator")
  invitations          Invitation[]         @relation("InviteRecipient")
  sentInvitations      Invitation[]         @relation("InviteSender")
  githubAccount        GithubAccount?
  githubInstallations  GithubInstallation[] @relation("GithubInstallationConnector")

  createdIssues  Issue[] @relation(name: "IssueCreator")
  assignedIssues Issue[] @relation(name: "IssueAssignees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id          String  @id @default(cuid())
  createdById String
  name        String
  slug        String  @unique
  description String?

  members            OrgMember[]
  projects           Project[]
  invitations        Invitation[]
  createdBy          User                @relation("OrgCreator", fields: [createdById], references: [id])
  githubInstallation GithubInstallation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrgMember {
  id     String  @id @default(cuid())
  orgId  String
  userId String
  role   OrgRole

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, userId])
  @@index([userId])
}

model Project {
  id          String  @id @default(cuid())
  orgId       String
  name        String
  slug        String
  description String?
  ownerId     String
  createdById String?
  color       String?

  githubRepoId        BigInt?
  githubRepoFullName  String?
  githubRepoUrl       String?
  githubDefaultBranch String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        User         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  teams        Team[]

  githubInstallationId String?
  githubInstallation   GithubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  codeEmbeddings       CodeEmbedding[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  routingClaimedAt DateTime?
  issues           Issue[]
  customColumns    CustomColumn[]

  @@unique([orgId, slug])
  @@index([ownerId])
  @@index([githubInstallationId])
}

model Team {
  id          String      @id @default(cuid())
  projectId   String
  name        String
  slug        String
  description String?
  projectRole ProjectRole

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
}

model TeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  role   TeamRole

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
}

model Invitation {
  id        String           @id @default(cuid())
  email     String
  // Null until the invited email has a matching account: invites are bound to an
  // email so they can be sent before the recipient signs up, and userId is stamped
  // when the invite is accepted (or when the account already exists at send time).
  token     String           @unique @default(cuid())
  status    InvitationStatus @default(Pending)
  expiresAt DateTime

  userId String?
  user   User?   @relation("InviteRecipient", fields: [userId], references: [id], onDelete: SetNull)

  invitedById String
  invitedBy   User   @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, orgId, teamId])
  @@index([email, status])
}

model GithubInstallation {
  id             String @id @default(cuid())
  orgId          String @unique
  installationId BigInt @unique
  accountLogin   String
  accountType    String
  accountId      BigInt
  connectedById  String

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connectedBy  User         @relation("GithubInstallationConnector", fields: [connectedById], references: [id], onDelete: Restrict)
  projects     Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([connectedById])
}

model GithubAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  githubUserId BigInt    @unique
  githubLogin  String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Issue {
  id          String      @id @default(cuid())
  projectId   String
  number      Int
  createdById String
  title       String
  description String      @db.Text
  status      IssueStatus @default(Todo)
  priority    Int         @default(3) // 1=Urgent 2=High 3=Normal 4=Low
  label       String?

  customColumnId String? // non-null = parked in a user column

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator      User          @relation(name: "IssueCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignees    User[]        @relation(name: "IssueAssignees")
  customColumn CustomColumn? @relation(fields: [customColumnId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, customColumnId])
  @@index([status, createdAt])
}

model CustomColumn {
  id        String @id @default(cuid())
  projectId String
  label     String
  order     Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model CodeEmbedding {
  id        String                      @id
  projectId String
  filePath  String
  chunkText String
  chunkType Chunk
  startLine Int
  endLinTe  Int
  embedding Unsupported("vector(1536)")
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("code_embeddings")
}

enum Chunk {
  Imports
  Function
  Class
  Interface
  Type
  Variable
  Block
}

enum InvitationStatus {
  Pending
  Accepted
  Rejected
}

enum OrgRole {
  Owner
  Admin
  Member
  Billing
}

enum IssueStatus {
  Todo
  Queued
  InProgress
  InReview
  Done
  Failed
  Cancelled
}

enum ProjectRole {
  Admin
  Maintain
  Write
  Triage
  Read
}

enum TeamRole {
  Maintainer
  Member
}
